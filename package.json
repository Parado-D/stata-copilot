{
  "name": "stata-copilot",
  "version": "0.5.2",
  "description": "stata-copilot 让 AI 像研究助理那样跑 Stata：回归结果直接读成 b/se/t/p 与 95% 区间，被省略的变量一并点名；erase、shell、只读模式下的写盘命令在到达 Stata 前就被拦下；每次运行记进可复现台账。插补、bootstrap 这类长任务转独立进程，不再被「Stata is busy」掐断；写 do 文件之前先挑出 Stata 不报错的那些错——if 只测第一个观测、_n 没有前置排序、重复 gen 触发 r(110)。零运行时依赖，用它自带的 pystata 引擎直接加载 Stata，不需要第二个包。",
  "keywords": [
    "stata",
    "mcp",
    "model-context-protocol",
    "econometrics",
    "replication",
    "claude-code",
    "codex",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "paradox",
  "type": "module",
  "bin": {
    "stata-copilot": "bin/stata-copilot.mjs"
  },
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./tools": "./src/tools/index.mjs",
    "./parsers": "./src/parsers/index.mjs",
    "./policy": "./src/policy.mjs",
    "./config": "./src/config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "bridge/",
    "skills/",
    "docs/",
    "examples/",
    "test/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "NOTICE",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/stata-copilot.mjs",
    "test": "node test/contracts.mjs && node test/offline.mjs",
    "test:contracts": "node test/contracts.mjs",
    "test:stata": "node test/smoke.mjs",
    "test:pystata": "node test/pystata.mjs",
    "demo": "node examples/real-analysis/run.mjs",
    "demo:paper": "node examples/paper/run.mjs",
    "demo:jobs": "node examples/jobs.mjs",
    "check": "node --check bin/stata-copilot.mjs && node test/contracts.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Parado-D/stata-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/Parado-D/stata-copilot/issues"
  },
  "homepage": "https://github.com/Parado-D/stata-copilot#readme"
}

{
  "name": "stata-copilot",
  "version": "0.4.1",
  "description": "MCP server + skills that turn an AI coding agent into a disciplined Stata analyst: structured results, command safety rails, and a reproducible run ledger. 让 AI 助手成为守规矩的 Stata 分析员：结构化结果、命令护栏、可复现台账，中文说明见 README.zh-CN.md。",
  "keywords": [
    "stata",
    "mcp",
    "model-context-protocol",
    "econometrics",
    "replication",
    "claude-code",
    "codex",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "paradox",
  "type": "module",
  "bin": {
    "stata-copilot": "bin/stata-copilot.mjs"
  },
  "main": "src/server.mjs",
  "exports": {
    ".": "./src/server.mjs",
    "./tools": "./src/tools/index.mjs",
    "./parsers": "./src/parsers/index.mjs",
    "./policy": "./src/policy.mjs",
    "./config": "./src/config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "docs/",
    "examples/",
    "test/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node bin/stata-copilot.mjs",
    "test": "node test/contracts.mjs && node test/offline.mjs",
    "test:contracts": "node test/contracts.mjs",
    "test:stata": "node test/smoke.mjs",
    "demo": "node examples/real-analysis/run.mjs",
    "demo:paper": "node examples/paper/run.mjs",
    "demo:jobs": "node examples/jobs.mjs",
    "check": "node --check bin/stata-copilot.mjs && node test/contracts.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Parado-D/stata-copilot.git"
  },
  "bugs": {
    "url": "https://github.com/Parado-D/stata-copilot/issues"
  },
  "homepage": "https://github.com/Parado-D/stata-copilot#readme"
}
